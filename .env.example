# Variabili facoltative, lette solo durante la build (nessun segreto).

# Indirizzo pubblico del sito, usato per l'immagine di anteprima social (og:image).
# Su Netlify non serve: viene usata automaticamente la variabile URL fornita dalla piattaforma.
# Impostarla solo per build eseguite altrove, con l'indirizzo reale del sito.
SITE_URL=

# Il concept è escluso dall'indicizzazione (noindex) perché non venga scambiato
# per un'azienda reale. Impostare "true" solo dopo una scelta consapevole.
SITE_ALLOW_INDEXING=false
